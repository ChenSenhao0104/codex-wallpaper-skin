<Window x:Class="CodexWallpaperSkin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Wallpaper Skin" Height="760" Width="1060"
        MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#111318" Foreground="#F2F4F8">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1E25"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303744"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#A8B0BF"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2B65D9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#596579"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                            <ContentPresenter Margin="10,4,34,4" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border Width="31" HorizontalAlignment="Right" Background="#202630"
                                                    BorderBrush="#596579" BorderThickness="1,0,0,0"
                                                    CornerRadius="0,3,3,0">
                                                <TextBlock Text="▼" Foreground="#DCE4F0" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="#0B0D11" BorderBrush="#68768A" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Padding="2">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#6EA8FF"/>
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAB4C2"/>
                                <Setter TargetName="ComboBorder" Property="Background" Value="#252A33"/>
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#444D5B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="#0B0D11"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#294F88"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B65D9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8D98A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="18"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="#202630"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <RepeatButton Grid.Row="0" Content="▲" FontSize="9" Foreground="#E8EEF7"
                                          Background="#303947" BorderBrush="#596579" BorderThickness="1"
                                          Focusable="False" Command="{x:Static ScrollBar.LineUpCommand}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="#171D26" BorderThickness="0" Focusable="False"
                                                  Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28" Background="#6E7F96" BorderBrush="#AFC0D7" BorderThickness="1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Margin="2,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="#171D26" BorderThickness="0" Focusable="False"
                                                  Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2" Content="▼" FontSize="9" Foreground="#E8EEF7"
                                          Background="#303947" BorderBrush="#596579" BorderThickness="1"
                                          Focusable="False" Command="{x:Static ScrollBar.LineDownCommand}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,3,0,10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="LanguageButton" Content="中文" Click="Language_Click"
                                Background="#3B4351" ToolTip="Switch between English and Chinese / 切换中英文"/>
                        <Button x:Name="ConnectButton" Content="Start / reconnect Codex" Click="Connect_Click"
                                ToolTip="Automatically connects to Codex or starts it with the local wallpaper channel."/>
                        <Button Content="Doctor" Click="Doctor_Click" Background="#3B4351" Margin="0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Codex connection" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            <Border x:Name="ConnectionStateBadge" Background="#3B4351" CornerRadius="9"
                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnectionStateText" Text="Not connected" FontSize="11" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="VersionText" Text="v0.8.0" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="One button handles normal startup and reconnection."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,2,12,0"/>
                    </StackPanel>
                </DockPanel>
                <Expander Grid.Row="1" Header="Advanced connection settings" Margin="0,10,0,0"
                          Foreground="{StaticResource MutedBrush}">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CDP" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <TextBox x:Name="EndpointTextBox" Grid.Column="1" VerticalAlignment="Center"
                                 ToolTip="Loopback only, e.g. http://127.0.0.1:9222"/>
                        <Button Grid.Column="2" Content="Activate endpoint" Click="ActivateWithCdp_Click"
                                Background="#3B4351" Margin="8,0"/>
                        <TextBox x:Name="AumidTextBox" Grid.Column="3" VerticalAlignment="Center"
                                 ToolTip="Official Codex package identity"/>
                        <Button Grid.Column="4" Content="Detect app" Click="DetectAumid_Click"
                                Background="#3B4351" Margin="8,0,0,0"/>
                    </Grid>
                </Expander>
            </Grid>
        </Border>

        <Border x:Name="FirstRunGuide" Grid.Row="1" Background="#14243A" BorderBrush="#315E96"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Got it" Click="DismissFirstRun_Click"
                        Background="#3B4351" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="First use" FontWeight="SemiBold" FontSize="15" Foreground="#D8E9FF"/>
                    <TextBlock Text="1. Click Start / reconnect Codex.  2. Choose a wallpaper.  3. Click Apply selected. The controller never closes Codex automatically."
                               Foreground="#BDD4F2" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="90" MaxHeight="180"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Wallpapers" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="Add local" Click="AddLocal_Click" Background="#3B4351"/>
                            <Button Content="Scan Wallpaper Engine" Click="ScanWallpaperEngine_Click" Margin="0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Search" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
                            <TextBox x:Name="WallpaperSearchTextBox" MinHeight="32"
                                     ToolTip="Search the current custom name, original name, or collection"
                                     TextChanged="WallpaperSearch_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Type filter" Margin="0,0,0,4" Foreground="#D7DFEB"/>
                            <ComboBox x:Name="WallpaperTypeFilter"
                                      DisplayMemberPath="Label" SelectionChanged="WallpaperFilter_SelectionChanged"
                                      ToolTip="Filter by wallpaper type"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Personal collection" Margin="0,0,0,4" Foreground="#D7DFEB"/>
                            <ComboBox x:Name="WallpaperCollectionFilter"
                                      DisplayMemberPath="Label" SelectionChanged="WallpaperFilter_SelectionChanged"
                                      ToolTip="Show all wallpapers or one personal collection"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="WallpaperList" Grid.Row="2" SelectionChanged="WallpaperList_SelectionChanged"
                             Background="#0E1116" Foreground="White" BorderBrush="{StaticResource BorderBrush}"
                             DisplayMemberPath="DisplayLabel" Padding="5"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBarStyle}"/>
                        </ListBox.Resources>
                    </ListBox>
                    <DockPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="WallpaperLibrarySummary" DockPanel.Dock="Right"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RenameWallpaperButton" Content="Rename" Click="RenameWallpaper_Click"
                                    Background="#3B4351" IsEnabled="False" ToolTip="Change only the name shown in this app"/>
                            <Button x:Name="SetCollectionButton" Content="Set collection" Click="SetCollection_Click"
                                    Background="#3B4351" IsEnabled="False" ToolTip="Organize this wallpaper in a personal collection"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="WallpaperDetails" Grid.Row="4" Foreground="{StaticResource MutedBrush}"
                               Margin="0,10,0,10" TextWrapping="Wrap" MinHeight="38"/>
                    <Border Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#0B0D11">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4"/>
                            <TextBlock x:Name="PreviewPlaceholder" Text="Select a wallpaper" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="360"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"
                              CanContentScroll="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBarStyle}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button Content="Original color / clarity" Click="OriginalFidelity_Click" DockPanel.Dock="Right"
                                    Background="#3B4351" Margin="8,0,0,0" ToolTip="Sets media opacity, overlay, brightness, contrast, saturation and blur to neutral values."/>
                            <TextBlock Text="Background settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Fit" Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="FitCombo" DisplayMemberPath="Label" SelectionChanged="SettingsChanged" Margin="0,3,0,10"/>
                        <Button Content="Show the complete wallpaper (may add margins)"
                                Click="ShowCompleteWallpaper_Click" Background="#3B4351"
                                HorizontalAlignment="Left" Margin="0,0,0,10"
                                ToolTip="Uses Contain and centers the source. A different aspect ratio cannot both fill the whole Codex window and show every edge."/>

                        <DockPanel><TextBlock Text="Focus X"/><TextBlock x:Name="FocusXValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="FocusXSlider|Focus X|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="FocusXSlider" Minimum="-100" Maximum="200" ValueChanged="SettingsChanged"
                                ToolTip="50% is centered. Extended values allow intentional panning beyond the normal CSS edge range."/>
                        <DockPanel><TextBlock Text="Focus Y"/><TextBlock x:Name="FocusYValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="FocusYSlider|Focus Y|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="FocusYSlider" Minimum="-100" Maximum="200" ValueChanged="SettingsChanged"
                                ToolTip="50% is centered. Extended values allow intentional panning beyond the normal CSS edge range."/>

                        <DockPanel><TextBlock Text="Background opacity"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="OpacitySlider|Background opacity|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" ValueChanged="SettingsChanged"/>
                        <DockPanel><TextBlock Text="Black readability overlay"/><TextBlock x:Name="OverlayValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="OverlaySlider|Black readability overlay|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="OverlaySlider" Minimum="0" Maximum="80" ValueChanged="SettingsChanged"/>

                        <DockPanel><TextBlock Text="Brightness"/><TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="BrightnessSlider|Brightness|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="BrightnessSlider" Minimum="50" Maximum="150" TickFrequency="1" ValueChanged="SettingsChanged"/>
                        <DockPanel><TextBlock Text="Contrast"/><TextBlock x:Name="ContrastValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="ContrastSlider|Contrast|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="ContrastSlider" Minimum="50" Maximum="150" TickFrequency="1" ValueChanged="SettingsChanged"/>
                        <DockPanel><TextBlock Text="Saturation"/><TextBlock x:Name="SaturationValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="SaturationSlider|Saturation|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="SaturationSlider" Minimum="0" Maximum="200" TickFrequency="1" ValueChanged="SettingsChanged"/>

                        <CheckBox x:Name="AutoPaletteCheck"
                                  Content="Automatically coordinate surfaces, accents and text"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <DockPanel><TextBlock Text="Palette strength"/><TextBlock x:Name="PaletteStrengthValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="PaletteStrengthSlider|Palette strength|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="PaletteStrengthSlider" Minimum="0" Maximum="100" ValueChanged="SettingsChanged"/>
                        <DockPanel><TextBlock Text="Panel opacity"/><TextBlock x:Name="PanelOpacityValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="PanelOpacitySlider|Panel opacity|%|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="PanelOpacitySlider" Minimum="20" Maximum="95" ValueChanged="SettingsChanged"/>
                        <CheckBox x:Name="TintTextCheck"
                                  Content="Coordinate inherited interface text (code colors stay intact)"
                                  Checked="SettingsChanged" Unchecked="SettingsChanged"/>

                        <DockPanel><TextBlock Text="Blur (0 = lowest GPU cost)"/><TextBlock x:Name="BlurValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="BlurSlider|Blur|px|0" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="BlurSlider" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged"/>

                        <DockPanel><TextBlock Text="Animation playback speed"/><TextBlock x:Name="RateValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="RateSlider|Animation playback speed|×|2" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="RateSlider" Minimum="25" Maximum="200" TickFrequency="5" ValueChanged="SettingsChanged"
                                ToolTip="Adjusts ordinary videos and Wallpaper Engine Scene playback from 0.25× to 2.00×."/>
                        <Button Content="Reset playback speed to 1.00×" Click="ResetPlaybackRate_Click"
                                Background="#3B4351" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <CheckBox x:Name="MutedCheck" Content="Mute video / Wallpaper Engine scene" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="PauseHiddenCheck" Content="Pause video / throttle scene while Codex is hidden" Checked="SettingsChanged" Unchecked="SettingsChanged"/>

                        <TextBlock Text="Performance profile" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                        <ComboBox x:Name="PerformanceProfileCombo" DisplayMemberPath="Label"
                                  SelectionChanged="PerformanceProfile_SelectionChanged" Margin="0,3,0,10"
                                  ToolTip="Choose a resource profile. Individual controls remain editable."/>
                        <TextBlock Text="Scene quality target (native capture is safely capped)" Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="SceneFpsCombo" SelectionChanged="SettingsChanged" Margin="0,3,0,10"/>
                        <DockPanel><TextBlock Text="Live scene render scale"/><TextBlock x:Name="SceneScaleValue" DockPanel.Dock="Right" Cursor="Hand" ToolTip="Click to enter an exact value" Tag="SceneScaleSlider|Live scene render scale|%|0" MouseLeftButtonUp="NumericValue_Click"/></DockPanel>
                        <Slider x:Name="SceneScaleSlider" Minimum="50" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SettingsChanged"/>

                        <Border Background="#121A27" BorderBrush="#274469" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,12">
                            <TextBlock Foreground="#B9D4FF" TextWrapping="Wrap"
                                       Text="Performance profiles adjust capture frame rate, render scale and hidden-window throttling. The last valid frame remains visible during brief capture or decode stalls."/>
                        </Border>

                        <CheckBox x:Name="AutoRestoreCheck"
                                  Content="Automatically reapply the last wallpaper when this controller opens"
                                  Checked="RestorePreferenceChanged" Unchecked="RestorePreferenceChanged"/>
                        <CheckBox x:Name="StartupRestoreCheck"
                                  Content="Remember the last wallpaper across Windows restarts (starts Codex if needed)"
                                  Checked="StartupRestoreChanged" Unchecked="StartupRestoreChanged"
                                  ToolTip="Adds or removes a per-user Windows startup entry. No administrator permission is required."/>
                        <TextBlock Text="Visual preset" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                        <ComboBox x:Name="VisualPresetCombo" DisplayMemberPath="Name"
                                  SelectionChanged="VisualPreset_SelectionChanged" Margin="0,3,0,8"
                                  ToolTip="Choose one of your named visual presets."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Apply preset" Click="ApplyVisualPreset_Click"
                                    Background="#3B4351"
                                    ToolTip="Applies the selected preset. Every value remains editable afterward."/>
                            <Button Content="Manage presets…" Click="VisualPresetSettings_Click"
                                    Background="#3B4351" Margin="0"
                                    ToolTip="Create, name, edit, delete, or restore visual presets."/>
                        </StackPanel>
                        <TextBlock x:Name="WallpaperPresetBindingText" Text="No preset is assigned to this wallpaper."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BindPresetButton" Content="Assign preset to wallpaper"
                                    Click="BindPresetToWallpaper_Click" Background="#3B4351" IsEnabled="False"
                                    ToolTip="Automatically use the selected visual preset whenever this wallpaper is applied."/>
                            <Button x:Name="ClearPresetBindingButton" Content="Clear assignment"
                                    Click="ClearWallpaperPresetBinding_Click" Background="#3B4351" Margin="0" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ApplyButton" Content="Apply selected" Click="Apply_Click" IsEnabled="False"/>
                            <Button Content="Restore Codex background" Click="Restore_Click" Background="#9A3944" Margin="0"/>
                        </StackPanel>
                        <ProgressBar x:Name="UploadProgress" Height="4" Minimum="0" Maximum="100" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#0E1116" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="Ready. Connect to a loopback CDP endpoint to apply a background."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
