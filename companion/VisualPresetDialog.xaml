<Window x:Class="CodexWallpaperSkin.VisualPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual preset settings" Height="560" Width="470"
        MinHeight="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#111318" Foreground="#F2F4F8">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#596579"/>
            <Setter Property="Width" Value="110"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B65D9"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock TextWrapping="Wrap" Foreground="#B9D4FF"
                   Text="These values are applied by the one-click high-clarity preset. They remain fully editable in the main window after the preset is applied."/>
        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Background opacity" VerticalAlignment="Center"/>
            <TextBox x:Name="OpacityText" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Grid.Row="1" Text="Black readability overlay" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBox x:Name="OverlayText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
            <TextBlock Grid.Row="2" Text="Brightness" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBox x:Name="BrightnessText" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
            <TextBlock Grid.Row="3" Text="Contrast" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBox x:Name="ContrastText" Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
            <TextBlock Grid.Row="4" Text="Saturation" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBox x:Name="SaturationText" Grid.Row="4" Grid.Column="1" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
            <TextBlock Grid.Row="5" Text="Panel opacity" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBox x:Name="PanelOpacityText" Grid.Row="5" Grid.Column="1" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="5" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
            <TextBlock Grid.Row="6" Text="Blur" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBox x:Name="BlurText" Grid.Row="6" Grid.Column="1" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="8,10,0,0"/>
            <TextBlock Grid.Row="7" Text="Scene capture scale" VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBox x:Name="SceneScaleText" Grid.Row="7" Grid.Column="1" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="7" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
        </Grid>
        <DockPanel Grid.Row="2">
            <Button Content="Built-in defaults" Click="BuiltInDefaults_Click" Background="#3B4351" DockPanel.Dock="Left" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Background="#3B4351"/>
                <Button Content="Save preset" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
