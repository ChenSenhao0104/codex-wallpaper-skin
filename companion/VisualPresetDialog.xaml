<Window x:Class="CodexWallpaperSkin.VisualPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage visual presets" Height="680" Width="560"
        MinHeight="620" MinWidth="520" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#111318" Foreground="#F2F4F8">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#596579"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Background" Value="#0E1116"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#596579"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                            <ContentPresenter Margin="10,4,34,4" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border Width="31" HorizontalAlignment="Right" Background="#202630"
                                                    BorderBrush="#596579" BorderThickness="1,0,0,0"
                                                    CornerRadius="0,3,3,0">
                                                <TextBlock Text="▼" Foreground="#DCE4F0" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="#0B0D11" BorderBrush="#68768A" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Padding="2">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#6EA8FF"/>
                                <Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAB4C2"/>
                                <Setter TargetName="ComboBorder" Property="Background" Value="#252A33"/>
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#444D5B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="#0B0D11"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#294F88"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B65D9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8D98A8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2B65D9"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Foreground="#B9D4FF"
                   Text="Create named presets for wallpapers with different brightness and colors. Applying a preset never prevents later manual adjustment."/>

        <Grid Grid.Row="1" Margin="0,16,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PresetCombo" DisplayMemberPath="Name"
                      SelectionChanged="PresetCombo_SelectionChanged"/>
            <Button Grid.Column="1" Content="New" Click="NewPreset_Click" Background="#3B4351"/>
            <Button Grid.Column="2" Content="Delete" Click="DeletePreset_Click" Background="#8B3540" Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Preset name" VerticalAlignment="Center"/>
            <TextBox x:Name="PresetNameText" Grid.Column="1" MaxLength="64"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Background opacity" VerticalAlignment="Center"/>
                <TextBox x:Name="OpacityText" Grid.Row="0" Grid.Column="1" Width="110"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Grid.Row="1" Text="Black readability overlay" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="OverlayText" Grid.Row="1" Grid.Column="1" Width="110" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
                <TextBlock Grid.Row="2" Text="Brightness" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="BrightnessText" Grid.Row="2" Grid.Column="1" Width="110" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
                <TextBlock Grid.Row="3" Text="Contrast" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="ContrastText" Grid.Row="3" Grid.Column="1" Width="110" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
                <TextBlock Grid.Row="4" Text="Saturation" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="SaturationText" Grid.Row="4" Grid.Column="1" Width="110" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
                <TextBlock Grid.Row="5" Text="Panel opacity" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="PanelOpacityText" Grid.Row="5" Grid.Column="1" Width="110" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
                <TextBlock Grid.Row="6" Text="Blur" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="BlurText" Grid.Row="6" Grid.Column="1" Width="110" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="8,10,0,0"/>
                <TextBlock Grid.Row="7" Text="Scene capture scale" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox x:Name="SceneScaleText" Grid.Row="7" Grid.Column="1" Width="110" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="7" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="8,10,0,0"/>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Restore built-in values" Click="BuiltInDefaults_Click"
                    Background="#3B4351" HorizontalAlignment="Left" Margin="0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" Background="#3B4351"/>
                <Button Content="Save preset library" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
