<Window x:Class="CodexWallpaperSkin.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Wallpaper Skin Doctor" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" Background="#111318" Foreground="#F2F4F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Read-only diagnostic report" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBox x:Name="ReportTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" Background="#0B0D11" Foreground="#DCE3EF" BorderBrush="#303744"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Export diagnostic package…" Click="Export_Click" Padding="14,7" Margin="0,0,8,0" Background="#3B4351" Foreground="White" BorderThickness="0"/>
            <Button Content="Copy" Click="Copy_Click" Padding="14,7" Margin="0,0,8,0" Background="#3B4351" Foreground="White" BorderThickness="0"/>
            <Button Content="Close" Click="Close_Click" Padding="14,7" Background="#2B65D9" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
